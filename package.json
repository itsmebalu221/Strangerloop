{
  "name": "strangrloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StrangrLoop — interest-based random stranger chat (frontend)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo.mjs",
    "seo:validate": "node scripts/validate-seo.mjs",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "server:dev": "npm --prefix server run dev",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:smoke": "npm --prefix server run smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
