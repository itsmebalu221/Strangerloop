# ─────────────────────────────────────────────────────────────
# StrangrLoop environment configuration
#
# CLIENT (Vite) — copy this file to `.env` for `npm run dev`.
# Only VITE_-prefixed variables are exposed to the browser.
# SERVER — used by server/ (and docker-compose.yml).
# NEVER commit `.env` — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── client: app identity ─────────────────────────────────────
VITE_APP_NAME=StrangrLoop
VITE_APP_URL=https://strangrloop.chat

# ── client: live server (optional) ───────────────────────────
# Point at a running strangrloop server to switch matching + chat
# from the local simulation to real people. Empty = demo mode.
#   VITE_SERVER_URL=http://localhost:8787
VITE_SERVER_URL=

# ── client: auth (optional, recommended for production) ──────
# Create a free project at https://supabase.com, then copy these
# from Project Settings → API. Leaving them empty enables the
# built-in demo auth (browser-local accounts + guest mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo auth fallback (used whenever the Supabase vars are empty).
# Set to "false" to disable guest/demo accounts entirely.
VITE_ENABLE_DEMO_AUTH=true

# ── server ───────────────────────────────────────────────────
# PORT=8787
# HOST=0.0.0.0
# Comma-separated browser origins allowed via CORS + sockets ("*" = any)
# CLIENT_ORIGIN=http://localhost:3000,https://strangrloop.chat
# Serve a built frontend from the same process (single-container deploys):
# STATIC_DIR=../dist
# Set true behind nginx/Caddy/Traefik (honors X-Forwarded-*)
# TRUST_PROXY=false
# SQLite file location (WAL journaling; directory is auto-created)
# DATABASE_PATH=./strangrloop.db
# Supabase project JWT secret → enables REAL token verification.
# Leave empty ONLY for local dev (demo tokens accepted).
# SUPABASE_JWT_SECRET=
# SUPABASE_URL=https://your-project.supabase.co
# Enables /admin/* endpoints; leave empty to disable admin API entirely.
# ADMIN_TOKEN=
