# ─────────────────────────────────────────────────────────────
# StrangrLoop environment configuration
# Copy this file to `.env`, fill in the values, restart the dev
# server. Only VITE_-prefixed variables are exposed to the client.
# NEVER commit `.env` — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# App identity
VITE_APP_NAME=StrangrLoop
VITE_APP_URL=https://strangrloop.chat

# ── Auth (optional, recommended for production) ─────────────
# Create a free project at https://supabase.com, then copy these
# from Project Settings → API. Leaving them empty enables the
# built-in demo auth (browser-local accounts + guest mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo auth fallback (used whenever the Supabase vars are empty).
# Set to "false" to disable guest/demo accounts entirely.
VITE_ENABLE_DEMO_AUTH=true
